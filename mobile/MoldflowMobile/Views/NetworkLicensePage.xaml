<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MoldflowMobile.Views.NetworkLicensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MoldflowMobile"
    xmlns:vm="clr-namespace:MoldflowMobile.ViewModels"
    x:DataType="vm:NetworkLicenseViewModel"
    Title="Network Licenses"
    BackgroundColor="#F7F8FC">

    <Grid RowDefinitions="Auto,*">

        <!-- =========================================================
             HEADER
             ========================================================= -->
        <Grid
            Padding="20,15,20,10"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">

            <VerticalStackLayout Spacing="2">
                <Label
                    Text="Uno"
                    FontSize="13"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#3157D5" />

                <Label
                    Text="Network Licenses"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#172033" />

                <Label
                    Text="{Binding LastUpdatedText}"
                    FontSize="12"
                    TextColor="#697386" />
            </VerticalStackLayout>

            <!-- History button -->
            <Button
                Grid.Column="1"
                Text="⏱ History"
                FontSize="13"
                FontAttributes="Bold"
                Padding="12,0"
                HeightRequest="42"
                CornerRadius="21"
                BackgroundColor="#EEF2FF"
                TextColor="#3157D5"
                Clicked="OnHistoryClicked" />

            <!-- Refresh button -->
            <Button
                Grid.Column="2"
                Text="↻"
                FontSize="20"
                WidthRequest="42"
                HeightRequest="42"
                CornerRadius="21"
                BackgroundColor="White"
                TextColor="#3157D5"
                Clicked="OnManualRefreshClicked" />

        </Grid>

        <!-- =========================================================
             MAIN SCROLLABLE CONTENT WITH PULL-TO-REFRESH
             ========================================================= -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Refreshing="OnRefreshViewRefreshing">

            <ScrollView>

                <VerticalStackLayout
                    Padding="16,4,16,24"
                    Spacing="16">

                    <!-- =====================================================
                         ERROR BANNER
                         ===================================================== -->
                    <Border
                        IsVisible="{Binding HasError}"
                        Padding="14"
                        BackgroundColor="#FEF2F2"
                        Stroke="#FCA5A5"
                        StrokeShape="RoundRectangle 12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    Text="Connection Issue"
                                    FontAttributes="Bold"
                                    TextColor="#991B1B"
                                    FontSize="14" />
                                <Label
                                    Text="{Binding ErrorMessage}"
                                    TextColor="#B91C1C"
                                    FontSize="12" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Retry"
                                FontSize="12"
                                HeightRequest="34"
                                CornerRadius="8"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                Clicked="OnManualRefreshClicked" />
                        </Grid>

                    </Border>

                    <!-- =====================================================
                         NON-POOLED DISCLAIMER BANNER
                         ===================================================== -->
                    <Border
                        Padding="14,12"
                        BackgroundColor="#EFF6FF"
                        Stroke="#BFDBFE"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label
                                    Text="ℹ️"
                                    FontSize="15"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Text="Independent License Pools"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    TextColor="#1E40AF" />
                            </Grid>
                            <Label
                                Text="{Binding NoticeText}"
                                FontSize="12"
                                TextColor="#1E3A8A" />
                            <Label
                                Text="Licenses are not pooled across servers. An available seat on one server cannot satisfy checkouts on another."
                                FontSize="11"
                                TextColor="#3B82F6" />
                        </VerticalStackLayout>

                    </Border>

                    <!-- =====================================================
                         ENVIRONMENT SUMMARY METRICS
                         ===================================================== -->
                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        ColumnSpacing="8">

                        <Border
                            Padding="8,10"
                            BackgroundColor="White"
                            Stroke="#E2E6EF"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label
                                    Text="{Binding TotalServers}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="#172033" />
                                <Label
                                    Text="SERVERS"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#697386"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="8,10"
                            BackgroundColor="White"
                            Stroke="#E2E6EF"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label
                                    Text="{Binding ServersUp}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="#16A34A" />
                                <Label
                                    Text="ONLINE"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#697386"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="8,10"
                            BackgroundColor="White"
                            Stroke="#E2E6EF"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label
                                    Text="{Binding ServersDown}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="#DC2626" />
                                <Label
                                    Text="OFFLINE"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#697386"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="3"
                            Padding="8,10"
                            BackgroundColor="White"
                            Stroke="#E2E6EF"
                            StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label
                                    Text="{Binding ActiveCheckoutsTotal}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="#3157D5" />
                                <Label
                                    Text="IN USE"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    TextColor="#697386"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- =====================================================
                         AGGREGATE ENVIRONMENT INVENTORY SECTION
                         ===================================================== -->
                    <Label
                        Text="Environment Inventory (Aggregate)"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#172033"
                        Margin="0,4,0,-6" />

                    <CollectionView
                        ItemsSource="{Binding AggregateProducts}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:AggregateProductInventory">
                                <Border
                                    Margin="0,4"
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#E2E6EF"
                                    StrokeShape="RoundRectangle 14">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="1">
                                                <Label
                                                    Text="{Binding EffectiveDisplayName}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="#172033" />
                                                <Label
                                                    Text="{Binding FeatureCode}"
                                                    FontSize="11"
                                                    TextColor="#697386" />
                                            </VerticalStackLayout>
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                BackgroundColor="#F1F5F9"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0">
                                                <Label
                                                    Text="{Binding UsedSummaryText}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="#3157D5" />
                                            </Border>
                                        </Grid>

                                        <ProgressBar
                                            Progress="{Binding UtilizationRatio}"
                                            HeightRequest="6"
                                            ProgressColor="#3157D5" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding TotalSummaryText}"
                                                FontSize="11"
                                                TextColor="#697386" />
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding AvailableSummaryText}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#16A34A" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- =====================================================
                         LICENSE SERVERS SECTION
                         ===================================================== -->
                    <Label
                        Text="License Servers (Independent Pools)"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#172033"
                        Margin="0,8,0,-6" />

                    <CollectionView
                        ItemsSource="{Binding Servers}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ServerOverviewItem">
                                <Border
                                    Margin="0,6"
                                    Padding="16"
                                    BackgroundColor="White"
                                    Stroke="#E2E6EF"
                                    StrokeShape="RoundRectangle 14">

                                    <VerticalStackLayout Spacing="10">

                                        <!-- SERVER HEADER -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{Binding DisplayName}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#172033" />
                                                <Label
                                                    Text="{Binding ServerSubtitle}"
                                                    FontSize="12"
                                                    TextColor="#697386" />
                                            </VerticalStackLayout>

                                            <!-- STATUS PILL -->
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,4"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0"
                                                BackgroundColor="{Binding StatusBadgeBg}"
                                                VerticalOptions="Start">
                                                <Label
                                                    Text="{Binding HealthDisplayText}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding StatusBadgeTextColor}" />
                                            </Border>
                                        </Grid>

                                        <!-- UNAVAILABLE SERVER NOTICE (Never says 0 available) -->
                                        <Border
                                            IsVisible="{Binding IsUnavailable}"
                                            Padding="10"
                                            BackgroundColor="#FEF3C7"
                                            Stroke="#FCD34D"
                                            StrokeShape="RoundRectangle 8">
                                            <Label
                                                Text="License data unavailable. Server is unreachable or vendor service is offline."
                                                FontSize="11"
                                                TextColor="#92400E" />
                                        </Border>

                                        <!-- PRODUCT LIST FOR THIS SERVER -->
                                        <CollectionView
                                            ItemsSource="{Binding Products}"
                                            SelectionMode="None"
                                            IsVisible="{Binding IsDataAvailable}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="local:LicensePackageDetail">
                                                    <Grid
                                                        Padding="0,4"
                                                        ColumnDefinitions="*,Auto,Auto"
                                                        ColumnSpacing="8">

                                                        <VerticalStackLayout Spacing="1">
                                                            <Label
                                                                Text="{Binding EffectiveDisplayName}"
                                                                FontSize="13"
                                                                FontAttributes="Bold"
                                                                TextColor="#172033" />
                                                            <Label
                                                                Text="{Binding FeatureCode}"
                                                                FontSize="10"
                                                                TextColor="#697386" />
                                                        </VerticalStackLayout>

                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding SeatsDisplay}"
                                                            FontSize="12"
                                                            TextColor="#172033"
                                                            VerticalOptions="Center" />

                                                        <Border
                                                            Grid.Column="2"
                                                            Padding="6,2"
                                                            StrokeShape="RoundRectangle 6"
                                                            StrokeThickness="0"
                                                            VerticalOptions="Center"
                                                            BackgroundColor="{Binding StatusBadgeBg}">
                                                            <Label
                                                                Text="{Binding StatusBadgeText}"
                                                                FontSize="10"
                                                                FontAttributes="Bold"
                                                                TextColor="{Binding StatusBadgeTextColor}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2" />

                                        <!-- ACTION BUTTONS: SERVER DETAIL & ACTIVE USERS -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button
                                                Text="Server Details"
                                                FontSize="12"
                                                HeightRequest="38"
                                                CornerRadius="10"
                                                BackgroundColor="#F4F5F9"
                                                TextColor="#3157D5"
                                                Clicked="OnServerDetailsClicked" />

                                            <Button
                                                Grid.Column="1"
                                                Text="Active Users"
                                                FontSize="12"
                                                HeightRequest="38"
                                                CornerRadius="10"
                                                BackgroundColor="#3157D5"
                                                TextColor="White"
                                                Clicked="OnServerConsumersClicked" />
                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ACTIVITY INDICATOR -->
                    <ActivityIndicator
                        IsVisible="{Binding IsBusy}"
                        IsRunning="{Binding IsBusy}"
                        HorizontalOptions="Center"
                        Color="#3157D5"
                        HeightRequest="40"
                        WidthRequest="40" />

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
