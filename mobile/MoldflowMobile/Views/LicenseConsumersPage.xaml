<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MoldflowMobile.Views.LicenseConsumersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MoldflowMobile"
    xmlns:vm="clr-namespace:MoldflowMobile.ViewModels"
    x:DataType="vm:LicenseConsumersViewModel"
    Title="Active Users"
    BackgroundColor="#F7F8FC">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Padding="20,16,20,8" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label
                    Text="{Binding ServerName}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#172033" />
                <Label
                    Text="{Binding ConsumerCount, StringFormat='{0} active physical seat checkout(s)'}"
                    FontSize="13"
                    TextColor="#697386" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="↻"
                FontSize="20"
                WidthRequest="42"
                HeightRequest="42"
                CornerRadius="21"
                BackgroundColor="White"
                TextColor="#3157D5"
                Clicked="OnRefreshClicked" />
        </Grid>

        <!-- MAIN LIST WITH PULL TO REFRESH -->
        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Refreshing="OnRefreshViewRefreshing">

            <ScrollView>

                <VerticalStackLayout Padding="16,8,16,24" Spacing="12">

                    <!-- EMPTY VIEW -->
                    <Border
                        IsVisible="{Binding IsEmpty}"
                        Padding="28"
                        BackgroundColor="White"
                        Stroke="#E2E6EF"
                        StrokeShape="RoundRectangle 14"
                        Margin="0,20,0,0">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label
                                Text="✓"
                                FontSize="36"
                                HorizontalOptions="Center"
                                TextColor="#16A34A" />
                            <Label
                                Text="No Active Checkouts"
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                TextColor="#172033" />
                            <Label
                                Text="All license seats on this server are currently free and available."
                                FontSize="13"
                                TextColor="#697386"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CONSUMERS COLLECTION -->
                    <CollectionView
                        ItemsSource="{Binding Consumers}"
                        SelectionMode="None"
                        IsVisible="{Binding HasConsumers}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ActiveConsumerItem">
                                <Border
                                    Margin="0,5"
                                    Padding="16"
                                    BackgroundColor="White"
                                    Stroke="#E2E6EF"
                                    StrokeShape="RoundRectangle 14">

                                    <VerticalStackLayout Spacing="10">

                                        <!-- Top Row: User and Borrowed Badge -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="1">
                                                <Label
                                                    Text="{Binding Username}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#172033" />
                                                <Label
                                                    Text="{Binding MachineName, StringFormat='Workstation: {0}'}"
                                                    FontSize="12"
                                                    TextColor="#697386" />
                                            </VerticalStackLayout>

                                            <!-- Borrowed Pill -->
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                BackgroundColor="#EFF6FF"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                VerticalOptions="Start">
                                                <Label
                                                    Text="{Binding BorrowedBadgeText}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#2563EB" />
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                                        <!-- Product & Version Details -->
                                        <Grid
                                            ColumnDefinitions="80,*"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="4"
                                            ColumnSpacing="6">

                                            <Label Text="Product" FontSize="12" TextColor="#697386" />
                                            <Label Grid.Column="1" Text="{Binding DisplayProductTitle}" FontSize="12" FontAttributes="Bold" TextColor="#172033" />

                                            <Label Grid.Row="1" Text="Version" FontSize="12" TextColor="#697386" />
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding DisplayVersion}" FontSize="12" TextColor="#172033" />

                                            <Label Grid.Row="2" Text="Checked out" FontSize="12" TextColor="#697386" />
                                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding CheckoutTimeDisplay}" FontSize="12" TextColor="#172033" />

                                        </Grid>

                                    </VerticalStackLayout>

                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ACTIVITY INDICATOR -->
                    <ActivityIndicator
                        IsVisible="{Binding IsBusy}"
                        IsRunning="{Binding IsBusy}"
                        HorizontalOptions="Center"
                        Color="#3157D5"
                        HeightRequest="40"
                        WidthRequest="40" />

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

    </Grid>

</ContentPage>
