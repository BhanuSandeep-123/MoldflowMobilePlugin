<Window x:Class="MoldflowAutomationCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Moldflow Automation Center" Height="760" Width="1200"
        MinWidth="1000" MinHeight="700"
        Background="{DynamicResource BrushBackground}"
        FontFamily="{DynamicResource FontSegoeUI}">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area (Sidebar, Workspace, Right Panel) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Timeline Panel -->
            <RowDefinition Height="140"/>
            <!-- Navigation Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================================
             1. HEADER PANEL
             =================================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand info -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Spacing -->
                    <ColumnDefinition Width="24"/>
                    <!-- Progress Info -->
                    <ColumnDefinition Width="*"/>
                    <!-- Controls -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo Placeholder (Representing Autodesk-style logo) -->
                    <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource BrushPrimary}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Moldflow Automation Center" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource BrushTextDark}"/>
                        <TextBlock Text="Project: Bracket_Optim_V3.mpi" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Progress Dashboard -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="20,0,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                        <TextBlock Text="Overall Phase: " FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="Phase 2 - Analysis Setup" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextDark}" Margin="0,0,16,0"/>
                        <TextBlock Text="Current Task: " FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                        <TextBlock Text="Material Selection (Running...)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Est. Remaining Time: ~14 mins" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="42" Maximum="100" Style="{DynamicResource FluentProgressBarStyle}"/>
                </Grid>

                <!-- Settings & Help Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Indicator -->
                    <Border CornerRadius="12" Background="#E8F0FE" Padding="10,4,10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushRunning}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Working Automatically" FontSize="11" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙ Settings" Style="{DynamicResource FluentButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="? Help" Style="{DynamicResource FluentButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================================
             2. MAIN WORKSPACE (STEPIER SIDEBAR, PAGE WINDOW, RIGHT INFO PANEL)
             =================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Stepper Sidebar -->
                <ColumnDefinition Width="250"/>
                <!-- Center Workspace Pages -->
                <ColumnDefinition Width="*"/>
                <!-- Right Summary Panel -->
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: AUTOMATION JOURNEY -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Automation Journey" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextDark}" Margin="0,0,0,16"/>

                        <!-- PHASE 1 -->
                        <TextBlock Text="PHASE 1: PROJECT SETUP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                        
                        <!-- Step Item Completed -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushSuccess}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Create Project" FontSize="13" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Step Item Completed -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushSuccess}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Import CAD" FontSize="13" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Step Item Completed -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushSuccess}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="CAD Diagnostics" FontSize="13" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>

                        <!-- PHASE 2 -->
                        <TextBlock Text="PHASE 2: ANALYSIS SETUP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                        
                        <!-- Step Item Completed -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushSuccess}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Analysis Sequence" FontSize="13" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Step Item Running (Current) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushRunning}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Material Selection" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}"/>
                        </Grid>
                        <!-- Step Item Waiting -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushWarning}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Process Settings" FontSize="13" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Step Item Pending -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushPending}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Gate Selection" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Grid>

                        <!-- PHASE 3 -->
                        <TextBlock Text="PHASE 3: SIMULATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushPending}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Mesh Generation" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushPending}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Mesh Diagnostics" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushPending}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Run Analysis" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Grid>

                        <!-- PHASE 4 -->
                        <TextBlock Text="PHASE 4: REPORTING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushPending}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Review Results" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Fill="{DynamicResource BrushPending}" Style="{DynamicResource StepperNodeStyle}"/>
                            <TextBlock Grid.Column="1" Text="Generate Report" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER WORKSPACE: DYNAMIC PLACEHOLDER FOR SELECTED PAGE -->
            <ScrollViewer Grid.Column="1" Padding="24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- Example Page Context (Material Selection Page) -->
                    <TextBlock Text="Material Selection" Style="{DynamicResource HeaderLabelStyle}"/>
                    <TextBlock Text="Search the material database and configure resin grade properties." Style="{DynamicResource MutedLabelStyle}" Margin="0,0,20,0"/>
                    
                    <!-- Search Input -->
                    <Grid Margin="0,16,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{DynamicResource FluentTextBoxStyle}" Margin="0,0,8,0" Tag="Search by Manufacturer, Grade name..."/>
                        <Button Grid.Column="1" Content="Search Database" Style="{DynamicResource FluentPrimaryButtonStyle}"/>
                    </Grid>

                    <TextBlock Text="Recommended Grades" Style="{DynamicResource SectionLabelStyle}"/>

                    <!-- Selection Grid Cards -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <!-- Material Card (Selected) -->
                        <Border BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="2" CornerRadius="6" Padding="12" Margin="0,0,8,8" Background="{DynamicResource BrushCardBackground}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Sabic Innovative Plastics" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushPrimary}"/>
                                    <TextBlock Text="SELECTED" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}"/>
                                </Grid>
                                <TextBlock Text="Lexan 141R" FontWeight="Bold" FontSize="15" Margin="0,4,0,4"/>
                                <TextBlock Text="Polycarbonate (PC) - General Purpose" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                <Separator Margin="0,8,0,8" Background="{DynamicResource BrushBorder}"/>
                                <Grid>
                                    <TextBlock Text="Melt Temp: 280-310 °C" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Text="Mold Temp: 70-90 °C" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Material Card -->
                        <Border Style="{DynamicResource FluentCardStyle}" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Covestro" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Text="Makrolon 2405" FontWeight="Bold" FontSize="15" Margin="0,4,0,4"/>
                                <TextBlock Text="Polycarbonate (PC) - Easy Release" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                <Separator Margin="0,8,0,8" Background="{DynamicResource BrushBorder}"/>
                                <Grid>
                                    <TextBlock Text="Melt Temp: 280-320 °C" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock Text="Mold Temp: 80-100 °C" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{DynamicResource FluentCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Material Information Card" Style="{DynamicResource SectionLabelStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Family Name:" FontWeight="SemiBold" Margin="0,0,8,6" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Polycarbonate (PC)" Margin="0,0,0,6" FontSize="12"/>
                                
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Trade Name:" FontWeight="SemiBold" Margin="0,0,8,6" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Lexan 141R" Margin="0,0,0,6" FontSize="12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Melt Density:" FontWeight="SemiBold" Margin="0,0,8,6" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="1.0667 g/cm³" Margin="0,0,0,6" FontSize="12"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Solid Density:" FontWeight="SemiBold" Margin="0,0,8,6" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="1.1983 g/cm³" Margin="0,0,0,6" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANEL: ALWAYS-VISIBLE LIVE SELECTIONS SUMMARY -->
            <Border Grid.Column="2" Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1,0,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Active Parameters" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextDark}" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Parameter Item -->
                            <TextBlock Text="Project Name" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="Bracket_Optimization_Study" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Current CAD File" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="bracket_hinge_v3.step" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Selected Analysis" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="Fill + Pack + Warp" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Selected Material" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="Lexan 141R (PC) - Sabic" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Current Temperatures" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="Melt: 295 °C / Mold: 80 °C" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Gate Status" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="✔ Gate Detected at Node [3411]" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushSuccess}" Margin="0,2,0,12"/>

                            <TextBlock Text="Mesh Status" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="⏳ Dual Domain (Pending Generation)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushWarning}" Margin="0,2,0,12"/>

                            <TextBlock Text="Study Name" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="Study_1_Gate1" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Elapsed Time" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="00:08:42" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>

                            <TextBlock Text="Current Workflow Phase" Style="{DynamicResource MutedLabelStyle}"/>
                            <TextBlock Text="PHASE 2 (Setup Analysis)" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================
             3. BOTTOM ACTIVITY TIMELINE
             =================================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSidebarBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,1" Padding="16,12,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Activity Log" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Timeline entry -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="11:20:15" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="✔" FontSize="11" Foreground="{DynamicResource BrushSuccess}"/>
                            <TextBlock Grid.Column="2" Text="Project 'Bracket_Optimization_Study' created." FontSize="11" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Timeline entry -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="11:21:04" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="✔" FontSize="11" Foreground="{DynamicResource BrushSuccess}"/>
                            <TextBlock Grid.Column="2" Text="CAD Model bracket_hinge_v3.step imported successfully." FontSize="11" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Timeline entry -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="11:22:30" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="✔" FontSize="11" Foreground="{DynamicResource BrushSuccess}"/>
                            <TextBlock Grid.Column="2" Text="CAD Diagnostics: Passed with 0 errors, 2 sliver faces auto-resolved." FontSize="11" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Timeline entry -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="11:24:10" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="✔" FontSize="11" Foreground="{DynamicResource BrushSuccess}"/>
                            <TextBlock Grid.Column="2" Text="Material Sabic Lexan 141R Polycarbonate selected." FontSize="11" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                        <!-- Timeline entry -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="11:25:01" FontSize="11" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Grid.Column="1" Text="⚡" FontSize="11" Foreground="{DynamicResource BrushPrimary}"/>
                            <TextBlock Grid.Column="2" Text="Waiting for Gate Selection parameters. System status is idle." FontSize="11" Foreground="{DynamicResource BrushTextDark}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================================================================
             4. BOTTOM NAVIGATION FOOTER
             =================================================================== -->
        <Border Grid.Row="3" Background="{DynamicResource BrushCardBackground}" Padding="20,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Previous" Style="{DynamicResource FluentButtonStyle}" Margin="0,0,10,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Pause" Style="{DynamicResource FluentButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Resume" Style="{DynamicResource FluentButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Cancel Workflow" Style="{DynamicResource FluentButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Continue" Style="{DynamicResource FluentPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
